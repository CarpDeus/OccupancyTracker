    private async Task<bool> GetOrganization()
    {
        try
        {
            organization = await OrganizationApi.GetAsync(orgSqid);
            SetBreadcrumbs();
            return true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            NavigatorService.NavigateTo("/NoAccess");
        }
        catch (System.Security.SecurityException se)
        {
            NavigatorService.NavigateTo("/NoAccess");
        }
        catch (Exception ex)
        {
            NavigatorService.NavigateTo("/Error");
        }
        return false;
    }
    private async Task<bool> GetEntrances(bool forceCacheRefresh = false)
    {
        try
        {
            if (!string.IsNullOrEmpty(locationSqid))
                entrances = await FacilityApi.ListEntrancesAsync(orgSqid, locationSqid);
            if (entrances == null) entrances = new List<Entrance>();
            hideEntranceList = entrances.Count == 0;

            return true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            NavigatorService.NavigateTo("/NoAccess");
        }
        catch (Exception ex)
        {
            NavigatorService.NavigateTo("/Error");
        }
        return false;
    }

    private async Task<bool> GetLocation()
    {
        try
        {
            location = await FacilityApi.GetLocationAsync(orgSqid, locationSqid);
            await GetEntrances();
            return true;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            NavigatorService.NavigateTo("/NoAccess");
        }
        catch (Exception ex)
        {
            NavigatorService.NavigateTo("/Error");
        }
        return false;
    }
    protected override async Task OnInitializedAsync()
    {
        userInformation = await ProfileApi.GetAsync();

        if (await GetOrganization())
        {
            if (locationSqid.ToLowerInvariant() == "new")
            {
                if (!await FacilityApi.CanCreateLocationAsync(orgSqid))
                {

                    hidden = true;
                    errorMessage = "You do not have permission to create locations for this organization";
                    Snackbar.Add(errorMessage, Severity.Error);
                }
                pageTitle = $"Location Details for new location belonging to {organization.OrganizationName}";
                entrances = new();
                readOnlyForm = false;
                userCanEdit = true;
                activePanelIndex = 0;
            }
            else
            {

                if (!await GetLocation()) return;
                pageTitle = $"Location Details for {location.LocationName}";
                activePanelIndex = 1;
            }

            if (locationSqid.ToLowerInvariant() != "new" && await FacilityApi.CanManageLocationAsync(orgSqid, locationSqid))
            {
                userCanEdit = true;

            }
        }
    }

    private void LocationChanged(Location updated)
    {
        location = updated;
        if (!string.IsNullOrEmpty(location.LocationSqid))
            pageTitle = $"Location Details for {location.LocationName}";
    }

