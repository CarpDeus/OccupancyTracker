@inject MudBlazor.ISnackbar Snackbar
@inject OrganizationUserApiClient OrganizationUsersApi



<MudDialog>
    <TitleContent>
        Organization User Invite
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2">Enter the email addresses of the users you would like to invite to this organization. Separate multiple email addresses with a comma, semi-colon or put on separate lines</MudText>
        <MudTextField Label="EmailAddresses" @bind-Value="emailAddresses" Lines="3" />
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="@submitting" OnClick="Cancel">Cancel</MudButton>
        <MudButton Disabled="@submitting" Color="Color.Primary" OnClick="Submit">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; }
    [Parameter]
    public Organization organization { get; set; }
    [Parameter]
    public UserInformation userInformation { get; set; }

    private string emailAddresses = string.Empty;
    private bool submitting;

    private async Task Submit()
    {
        var emails = emailAddresses.Split(new[] { ',', ';', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (emails.Length == 0)
        {
            Snackbar.Add("Enter at least one email address.", Severity.Error);
            return;
        }
        submitting = true;
        try
        {
            var failed = new List<string>();
            foreach (var email in emails)
            {
                try
                {
                    if (!await OrganizationUsersApi.InviteAsync(organization.OrganizationSqid!, email))
                    {
                        failed.Add(email);
                        Snackbar.Add($"Unable to invite {email}: the API did not accept the invitation.", Severity.Error);
                    }
                }
                catch (HttpRequestException ex)
                {
                    failed.Add(email);
                    Snackbar.Add($"Unable to invite {email}: {ex.Message}", Severity.Error);
                }
            }
            if (failed.Count > 0)
            {
                emailAddresses = string.Join(", ", failed);
                return;
            }
            Snackbar.Add("Invitations queued.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            submitting = false;
        }
    }
    

    private void Cancel() => MudDialog.Cancel();
}
