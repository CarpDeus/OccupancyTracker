@page "/sso-post-signon"
@layout Layout.EmptyLayout
@using Microsoft.AspNetCore.WebUtilities
@inject IOccAuthorizationService Authorization
@inject NavigationManager Navigation

@code {
    [CascadingParameter] public Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateTask;
        var user = await Authorization.GetFromStateAsync(state);
        if (user == null)
        {
            Navigation.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        var returnUrl = query.TryGetValue("returnUrl", out var value) ? value.ToString() : "/";
        if (!LocalRedirect.IsSafe(returnUrl)) returnUrl = "/";
        if (!Authorization.HasCompletedRegistration(user))
            Navigation.NavigateTo($"/profile/edit?returnUrl={Uri.EscapeDataString(returnUrl)}");
        else
            Navigation.NavigateTo(returnUrl);
    }
}
