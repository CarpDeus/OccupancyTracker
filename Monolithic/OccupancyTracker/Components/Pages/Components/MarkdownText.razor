@inject PublicContentApiClient PublicContentApi
<MudMarkdown Value="@markdownText"></MudMarkdown>

@code {
    [Parameter] public required string PageName { get; set; }
    [Parameter] public required string TextIdentifier { get; set; }

    private string markdownText = "";

    protected override async Task OnInitializedAsync()
    {
        if (TextIdentifier != "body")
            throw new InvalidOperationException("Only public page body content is available.");
        markdownText = await PublicContentApi.GetAsync(PageName);
    }



}
