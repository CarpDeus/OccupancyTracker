# Local development only. Replace placeholders; do not commit .env.api.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Occupancy='Server=<sql-server-host>,1433;Database=OccupancyTracker;User Id=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;'
Oidc__Authority=https://<identity-host>/<provider-path>
Oidc__ClientId=<api-client-id>
Oidc__ClientSecret=<client-secret>
Oidc__CallbackPath=/signin-oidc
Oidc__PublicOrigin=http://localhost:5236
Oidc__UiCallback=http://localhost:5195/sso-callback
Oidc__SuperAdminGroup=<admin-group-name>
Oidc__RequireVerifiedEmail=true
Jwt__Issuer=occupancy
Jwt__Audience=occupancy-api
Jwt__SigningKey=<base64-encoded-random-key>
Sqids__0__AlphabetName=Default
Sqids__0__Alphabet=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
Sqids__1__AlphabetName=UserInformation
Sqids__1__Alphabet=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
enyimMemcached__Servers__0__Address=memcached
enyimMemcached__Servers__0__Port=11211
SendGridKey=<sendgrid-api-key>
OccupancyDomain=<public-ui-hostname>
DatabaseInitialization__Enabled=true
BackgroundProcessors__Enabled=true
